{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HawkeyeHub Plugin Manifest (PROTOTYPE, Hub API 1)",
  "description": "Every field is required and no other field is allowed. Each part a Plugin may lack is a closed enum of kinds. Mirrors the Manifest type in hub.d.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "hubApi", "name", "description", "platforms", "identity", "stores", "backend", "assistant"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "description": "Kebab-case; also the Registry tag plugin/<id>@<version>." },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "hubApi": { "type": "string", "description": "semver range of Hub API versions, e.g. ^1.0.0 (ADR 0005)." },
    "name": { "$ref": "#/$defs/displayText" },
    "description": { "$ref": "#/$defs/displayText" },
    "platforms": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "enum": ["win32-x64", "darwin-arm64"] }
    },
    "identity": {
      "oneOf": [
        { "$ref": "#/$defs/none" },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "roles"],
          "properties": {
            "kind": { "const": "required", "description": "The Plugin needs a Staff Identity; roles may be empty (ADR 0002)." },
            "roles": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
          }
        }
      ]
    },
    "stores": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
    },
    "backend": {
      "oneOf": [
        { "$ref": "#/$defs/none" },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "python"],
          "properties": {
            "kind": { "const": "python" },
            "python": { "type": "string", "pattern": "^3\\.\\d+$", "description": "Minor version; must agree with backend/pyproject.toml requires-python." }
          }
        }
      ]
    },
    "assistant": {
      "oneOf": [
        { "$ref": "#/$defs/none" },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "templates"],
          "properties": {
            "kind": { "const": "enabled", "description": "The Plugin ships agents/assistant.md and agents/skills/." },
            "templates": {
              "type": "array",
              "items": {
                "type": "object", "additionalProperties": false, "required": ["label", "text"],
                "properties": { "label": { "$ref": "#/$defs/displayText" }, "text": { "$ref": "#/$defs/displayText" } }
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "none": {
      "type": "object", "additionalProperties": false, "required": ["kind"],
      "properties": { "kind": { "const": "none" } }
    },
    "displayText": {
      "description": "Plain English, or a map keyed by exact Display Language tags that must include en-HK (ADR 0007).",
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object", "required": ["en-HK"], "propertyNames": { "enum": ["en-HK", "zh-HK"] },
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      ]
    }
  }
}
