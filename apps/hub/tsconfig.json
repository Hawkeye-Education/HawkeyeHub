{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    // plugin-format's sources name their `.ts` imports, for its CLI under Node's type stripping.
    "allowImportingTsExtensions": true
  },
  "include": ["src", "e2e", "*.config.ts"],
  // The Hub Chrome, the preloads and the Hub Kit run in a page: each has its own tsconfig, with DOM.
  "exclude": ["src/renderer", "src/preload", "src/hub-kit"]
}
