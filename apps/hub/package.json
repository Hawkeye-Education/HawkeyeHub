{
  "name": "@hawkeye-hub/hub",
  "productName": "Hawkeye Hub",
  "version": "0.1.0",
  "description": "Hawkeye Education's staff tools, as Plugins",
  "author": "Hawkeye Education",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "smoke": "electron-vite build && playwright test",
    "typecheck": "tsc && tsc -p src/renderer && tsc -p src/preload && tsc -p src/hub-kit",
    "test": "vitest run",
    "package": "electron-vite build && electron-builder --win"
  },
  "build": {
    "appId": "education.hawkeye.hub",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "HawkeyeHub-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "@hawkeye-hub/hub-api": "workspace:*",
    "@hawkeye-hub/plugin-format": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/markdown-it": "14.2.0",
    "@types/node": "22.17.2",
    "@types/semver": "7.8.0",
    "electron": "44.5.1",
    "electron-builder": "26.16.1",
    "electron-vite": "5.0.0",
    "lit": "3.3.3",
    "markdown-it": "15.0.3",
    "semver": "7.8.5",
    "vite": "7.3.6",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.87",
    "@ai-sdk/openai-compatible": "3.0.77",
    "ai": "7.0.150",
    "fflate": "0.8.2"
  }
}
